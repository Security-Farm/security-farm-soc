(1,'RT::SavedSearch',3,'json','{\"Format\":\"\'<a href=\\\"__WebPath__/Ticket/Display.html?id=__id__\\\">__id__</a>/TITLE:#\',\'<a href=\\\"__WebPath__/Ticket/Display.html?id=__id__\\\">__Subject__</a>/TITLE:Subject\',Priority, QueueName, ExtendedStatus\",\"Order\":\"DESC\",\"OrderBy\":\"Priority\",\"Query\":\" Owner = \'__CurrentUser__\' AND ( Status = \'new\' OR Status = \'open\')\"}',1,'2026-02-07 03:02:41',1,'2026-02-07 03:02:41',0),
(2,'RT::SavedSearch',4,'json','{\"Format\":\"\'<a href=\\\"__WebPath__/Ticket/Display.html?id=__id__\\\">__id__</a>/TITLE:#\',\'<a href=\\\"__WebPath__/Ticket/Display.html?id=__id__\\\">__Subject__</a>/TITLE:Subject\',QueueName, ExtendedStatus, CreatedRelative, \'<A HREF=\\\"__WebPath__/Ticket/Display.html?Action=Take&id=__id__\\\">__loc(Take)__</a>/TITLE:NBSP\'\",\"Order\":\"DESC\",\"OrderBy\":\"Created\",\"Query\":\" Owner = \'Nobody\' AND ( Status = \'new\' OR Status = \'open\')\"}',1,'2026-02-07 03:02:41',1,'2026-02-07 03:02:41',0),
(3,'RT::SavedSearch',5,'json','{\"Format\":\"\'<a href=\\\"__WebPath__/Ticket/Display.html?id=__id__\\\">__Subject__</a>/TITLE:Subject\',\\n\'__LastUpdatedRelative__\',\\n\'__OwnerName__\',\\nPriority,\\nQueueName,\\n\'__Status__\',\\nBookmark\",\"Order\":\"DESC|ASC|ASC|ASC\",\"OrderBy\":\"LastUpdated|Subject||\",\"Query\":\"id = \'__Bookmarked__\'\",\"RowsPerPage\":\"50\"}',1,'2026-02-07 03:02:41',1,'2026-02-07 03:02:41',0),
